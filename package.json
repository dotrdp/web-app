{
  "name": "agrocebada-fira-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 8082 --strictPort",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview:demo": "vite preview --host 127.0.0.1 --port 8082 --strictPort",
    "deploy": "npm run build:demo && wrangler deploy",
    "preview": "node server/index.mjs --production",
    "start": "node server/index.mjs --production",
    "check": "tsc -b",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:demo": "npm run build:demo && AGROCEBADA_DEMO=1 playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/match-sorter-utils": "^9.2.6",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cobe": "2.0.1",
    "date-fns": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "motion": "^14.0.0",
    "next-themes": "0.4.6",
    "ol": "^10.8.0",
    "ol-mapbox-style": "13.5.1",
    "proj4": "^2.20.0",
    "radix-ui": "1.6.7",
    "react": "^19.2.0",
    "react-aria-components": "^1.21.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "recharts": "3.10.1",
    "robust-predicates": "^3.0.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "shadcn": "4.21.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wrangler": "4.80.0"

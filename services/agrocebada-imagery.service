[Unit]
Description=AgroCebada agrocebada-imagery on rig
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/fira2026/webapp
EnvironmentFile=%h/code/fira2026/webapp/.data-cache/deployment/service.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/code/fira2026/webapp/services/.venv/bin/python -m uvicorn api:app --app-dir services --host 127.0.0.1 --port 8090
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=default.target
